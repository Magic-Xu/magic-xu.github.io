{
  "name": "magic-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:journal": "JOURNAL_PREVIEW=1 astro dev",
    "build:journal-preview": "JOURNAL_PREVIEW=1 astro build",
    "preview:journal": "JOURNAL_PREVIEW=1 astro preview",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro sync && tsc --noEmit",
    "test": "playwright test",
    "test:journal": "playwright test --config playwright.journal.config.ts",
    "test:startup": "playwright test tests/startup.spec.ts",
    "test:ui": "playwright test --ui",
    "landscape:posters": "node scripts/capture-landscape-posters.mjs",
    "landscape:assets": "node scripts/prepare-landscape-opening.mjs"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
