---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "../data/site";
import "../styles/global.css";

interface Props {
	lang?: string;
	metaTitle?: string;
	metaDescription?: string;
	home?: boolean;
}

const {
	lang = "zh-CN",
	metaTitle,
	metaDescription = siteConfig.description,
	home = false
} = Astro.props;
const pageTitle = metaTitle ? `${metaTitle} · ${siteConfig.title}` : siteConfig.title;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url);
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={metaDescription} />
		<meta name="author" content={siteConfig.author} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content={home ? "#142921" : "#eeece3"} />
		<link rel="stylesheet" href="/fonts/noto-serif-sc.css" />
		<link rel="alternate" type="application/rss+xml" title="小麦在野" href="/rss.xml" />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={`${siteConfig.url}/images/home/mountain-green-ridges.webp`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<title>{pageTitle}</title>
		<ClientRouter />
	</head>
	<body class:list={[home && "home-page"]}>
		<a class="skip-link" href="#main-content">跳到正文</a>
		<div class="site-shell">
			<Header home={home} />
			<main class="site-main" id="main-content">
				<slot />
			</main>
			<Footer />
		</div>
		<script>
			import "../scripts/motion";
		</script>
	</body>
</html>
