---
import { getLocaleContent } from "../content";
import { siteConfig } from "../data/site";

const pathname = Astro.url.pathname;
const content = getLocaleContent();
const links = content.navigation;

const normalizePath = (path: string) => path !== "/" && path.endsWith("/") ? path.slice(0, -1) : path;
const normalizedPathname = normalizePath(pathname);
const isActive = (href: string) => {
	const normalizedHref = normalizePath(href);
	return normalizedPathname === normalizedHref || normalizedPathname.startsWith(`${normalizedHref}/`);
};
---

<header class="site-header" transition:persist>
	<div class="container header-inner">
		<a class="site-brand" href="/" data-astro-prefetch="load">{siteConfig.title}</a>
		<nav class="site-nav" aria-label="主导航">
			{links.map((item) => (
				<a
					class={isActive(item.href) ? "nav-link active" : "nav-link"}
					href={item.href}
					data-astro-prefetch="load"
					aria-current={isActive(item.href) ? "page" : undefined}
				>
					{item.label}
				</a>
			))}
			<a class="nav-link nav-external" href={siteConfig.github} target="_blank" rel="noreferrer">
				GitHub <span aria-hidden="true">↗</span>
			</a>
		</nav>
	</div>
</header>
