---
import { getLocaleContent } from "../content";
import { siteConfig } from "../data/site";

const pathname = Astro.url.pathname;
const { home = false } = Astro.props;
const content = getLocaleContent();
const links = content.navigation;

const normalizePath = (path: string) => path !== "/" && path.endsWith("/") ? path.slice(0, -1) : path;
const normalizedPathname = normalizePath(pathname);
const isActive = (href: string) => {
	const normalizedHref = normalizePath(href);
	return normalizedPathname === normalizedHref || normalizedPathname.startsWith(`${normalizedHref}/`);
};
---

<header class:list={["site-header", home && "site-header-hero"]}>
	<div class="container header-inner">
		<a class="site-brand" href="/" data-astro-prefetch="load"><svg class="brand-land" viewBox="0 0 36 30" aria-hidden="true"><path d="m2 22 9-15 7 10 7-14 9 19M2 27h32" /></svg><span>{home ? "MagicXu" : siteConfig.title}</span></a>
		<nav class="site-nav" aria-label="主导航">
			{links.map((item) => (
				<a
					class={isActive(item.href) ? "nav-link active" : "nav-link"}
					href={item.href}
					data-astro-prefetch="load"
					aria-current={isActive(item.href) ? "page" : undefined}
				>
					{item.label}
				</a>
			))}

		</nav>
	</div>
</header>

<style>
	@media (max-width: 600px) {
		.site-header .header-inner { display: grid; grid-template-columns: 1fr; gap: 2px; min-height: 108px; padding-block: 14px 7px; }
		.site-header .site-brand { justify-self: start; line-height: 1.6; }
		.site-header .site-nav { justify-content: space-between; gap: 4px; width: 100%; }
		.site-header .nav-link { justify-content: center; min-width: 44px; min-height: 44px; }
		.site-header .nav-link::after { left: 8px; right: 8px; bottom: 4px; }
	}
</style>
