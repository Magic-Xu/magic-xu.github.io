---
import { getLocaleContent } from "../content";
import { siteConfig } from "../data/site";

const pathname = Astro.url.pathname;
const { home = false } = Astro.props;
const content = getLocaleContent();
const links = content.navigation;

const normalizePath = (path: string) => path !== "/" && path.endsWith("/") ? path.slice(0, -1) : path;
const normalizedPathname = normalizePath(pathname);
const isActive = (href: string) => {
	const normalizedHref = normalizePath(href);
	return normalizedPathname === normalizedHref || normalizedPathname.startsWith(`${normalizedHref}/`);
};
---

<header class:list={["site-header", home && "site-header-hero"]}>
	<div class="container header-inner">
		<a class="site-brand" href="/" data-astro-prefetch="load"><svg class="brand-land" viewBox="0 0 36 30" aria-hidden="true"><path d="m2 22 9-15 7 10 7-14 9 19M2 27h32" /></svg><span>{home ? "MagicXu" : siteConfig.title}</span></a>
		<nav class="site-nav" aria-label="主导航">
			{links.map((item) => (
				<a
					class={isActive(item.href) ? "nav-link active" : "nav-link"}
					href={item.href}
					data-astro-prefetch="load"
					aria-current={isActive(item.href) ? "page" : undefined}
				>
					{item.label}
				</a>
			))}

		</nav>
	</div>
</header>
