---
import Arrow from "./Arrow.astro";

interface Props { kind: "notes" | "footprints"; }
const { kind } = Astro.props;
const isNotes = kind === "notes";
---

<div class:list={["journal-empty", `journal-empty-${kind}`]}>
	<div class="empty-illustration" aria-hidden="true">
		{isNotes ? <svg viewBox="0 0 300 220" fill="none">
			<path class="illustration-wash" d="M76 30h128l20 20v144H76z" />
			<path class="illustration-outline" d="M76 30h128l20 20v144H76zM204 30v22h20" />
			<path class="illustration-faint" d="M64 43v162h148M95 76h81M95 99h109M95 122h91M95 145h55" />
			<path class="illustration-accent" d="m186 155 31-48 9 6-32 48-12 9zM186 155l8 6M217 107l9 6" />
			<path class="illustration-ground" d="M36 205h25m19 0h173" />
		</svg> : <svg viewBox="0 0 300 220" fill="none">
			<path class="illustration-wash" d="m26 170 50-83 36 39 48-85 46 80 35-42 36 91z" />
			<path class="illustration-outline" d="m26 170 50-83 36 39 48-85 46 80 35-42 36 91" />
			<path class="illustration-faint" d="m135 85 25 12 23-15M57 119l20 9 13-11m131-14 20 11 13-9" />
			<path class="illustration-accent" d="M145 128c-33 13-43 29-14 35s53 18 22 42" />
			<path class="illustration-faint" d="M137 139c-13 9-4 13 15 18s34 14 27 29" />
			<path class="illustration-ground" d="M25 191h61m119 0h70" />
		</svg>}
	</div>
	<div class="empty-copy">
		<h2>{isNotes ? "随笔，慢慢写。" : "足迹，慢慢记。"}</h2>
		<p>{isNotes ? "这里还没有随笔。先从一篇文章认识我吧。" : "这里还没有旅途记录。先看看最近在做的事。"}</p>
		<a class="text-link" href={isNotes ? "/writing/" : "/projects/"}>{isNotes ? "去读文章" : "看看作品"}<Arrow /></a>
	</div>
</div>

<style>
	.journal-empty { display: grid; grid-template-columns: minmax(200px, 360px) minmax(0, 500px); justify-content: center; align-items: center; gap: clamp(34px, 5vw, 78px); min-height: 280px; padding: 32px 30px 40px; border-block: 1px solid var(--color-line); }
	.empty-illustration { width: min(100%, 270px); justify-self: center; }
	.empty-illustration svg { display: block; width: 100%; stroke-linecap: round; stroke-linejoin: round; }
	.illustration-wash { fill: var(--color-surface-raised); fill-opacity: .45; }
	.illustration-outline { stroke: var(--color-line-strong); stroke-width: 1.4; }
	.illustration-faint, .illustration-ground { stroke: var(--color-line-strong); stroke-width: 1; }
	.illustration-faint { opacity: .72; }
	.illustration-ground { opacity: .55; }
	.illustration-accent { stroke: var(--color-accent); stroke-width: 1.5; opacity: .7; }
	.empty-copy h2 { margin: 0; font: 400 30px/1.6 var(--font-serif); letter-spacing: 1px; }
	.empty-copy p { max-width: 29em; margin-top: 15px; color: var(--color-muted); font: 14px/1.9 var(--font-sans); text-wrap: pretty; }
	.empty-copy .text-link { margin-top: 24px; gap: 22px; }
	@media (max-width: 760px) {
		.journal-empty { grid-template-columns: 1fr; justify-items: start; gap: 22px; min-height: 0; padding: 28px 0 34px; }
		.empty-illustration { justify-self: start; width: 175px; margin-left: -15px; }
		.empty-copy h2 { font-size: 25px; }
		.empty-copy p { margin-top: 12px; max-width: 23em; }
		.empty-copy .text-link { margin-top: 20px; }
	}
	@media (max-width: 600px) and (max-height: 680px) {
		.journal-empty { padding-block: 20px 26px; }
		.empty-illustration { display: none; }
		.empty-copy p { margin-top: 10px; font-size: 13px; line-height: 1.85; }
		.empty-copy .text-link { margin-top: 12px; }
	}
</style>
