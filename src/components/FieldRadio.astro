---
import { radioChannels, radioCover } from "../data/radio";
const firstChannel = radioChannels[0];
const first = firstChannel.tracks[0];
const time = (seconds: number) => `${Math.floor(seconds / 60)}:${String(Math.floor(seconds % 60)).padStart(2, "0")}`;
---

<section class="field-radio" data-radio transition:persist="field-radio" aria-label="在野电台" hidden>
  <audio data-audio preload="none"></audio>
  <div class="radio-launcher" data-launcher>
    <button class="radio-open" data-open type="button" aria-label="展开在野电台" aria-controls="radio-panel" aria-expanded="false">
      <span class="radio-record" aria-hidden="true"><img data-disc-cover src={radioCover(first)} width="32" height="32" alt="" loading="lazy" /></span>
      <span class="radio-launcher-copy"><span>在野电台</span><span data-mini-status>听一会儿</span></span>
    </button>
    <button class="radio-mini-play radio-icon-button" data-play type="button" aria-label="播放音乐">
      <svg class="radio-play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7Z" fill="currentColor" stroke="none" /></svg>
      <svg class="radio-pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6v12M16 6v12" stroke-width="3" /></svg>
    </button>
  </div>

  <div id="radio-panel" class="radio-panel" data-panel role="dialog" aria-modal="false" aria-labelledby="radio-heading" hidden>
    <header class="radio-heading-row">
      <h2 id="radio-heading"><span class="radio-signal" aria-hidden="true"><i></i><i></i><i></i></span>在野电台</h2>
      <button class="radio-icon-button radio-collapse" data-close type="button" aria-label="收起电台，保留播放"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></button>
    </header>
    <button class="radio-channel-toggle" data-channel-toggle type="button" aria-label={`切换频道，当前${firstChannel.title}`} aria-expanded="false" aria-controls="radio-channels">
      <span class="radio-channel-caption">频道</span><span data-channel-title>{firstChannel.title}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 10 5 5 5-5" /></svg>
    </button>
    <div class="radio-channel-region" data-channel-region hidden inert>
      <div id="radio-channels" class="radio-channels" data-channels role="group" aria-label="选择音乐频道">
        {radioChannels.map(channel => <button data-channel={channel.id} type="button" aria-pressed={channel.id === firstChannel.id ? "true" : "false"}><span>{channel.title}</span><small>{channel.kind} · {channel.tracks.length} 首</small></button>)}
      </div>
    </div>
    <div class="radio-now">
      <img class="radio-cover" data-cover src={radioCover(first)} width="80" height="80" alt={`${first.title}封面`} loading="lazy" />
      <div class="radio-track-copy"><p class="radio-mood" data-mood>{first.mood}</p><h3 data-title>{first.title}</h3><p class="radio-artist" data-artist>{first.artist}</p></div>
    </div>
    <p class="radio-message" data-message role="status" aria-live="polite">让音乐陪你待一会儿。</p>
    <div class="radio-progress">
      <input data-seek type="range" min="0" max={first.duration} value="0" step="0.1" aria-label="播放进度" aria-valuetext={`0:00，共 ${time(first.duration)}`} />
      <div class="radio-times"><span data-current>0:00</span><span data-duration>{time(first.duration)}</span></div>
    </div>
    <div class="radio-transport">
      <button class="radio-icon-button" data-previous type="button" aria-label="上一首"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5v14M18 5 8 12l10 7Z" /></svg></button>
      <button class="radio-main-play" data-play type="button" aria-label="播放音乐">
        <svg class="radio-play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7Z" fill="currentColor" stroke="none" /></svg>
        <svg class="radio-pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6v12M16 6v12" stroke-width="3" /></svg>
      </button>
      <button class="radio-icon-button" data-next type="button" aria-label="下一首"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 5v14M6 5l10 7-10 7Z" /></svg></button>
    </div>
    <footer class="radio-tools">
      <div class="radio-volume"><button class="radio-icon-button" data-mute type="button" aria-label="静音" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m11 5-5 4H3v6h3l5 4Z" /><path class="radio-volume-waves" d="M15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14" /><path class="radio-mute-line" d="m16 9 5 6m0-6-5 6" /></svg></button><input data-volume type="range" min="0" max="1" step="0.01" value="0.45" aria-label="音量" aria-valuetext="45%" /></div>
      <span class="radio-ai">AI 生成</span>
      <button class="radio-list-toggle" data-list-toggle type="button" aria-label="查看当前频道播放列表" aria-expanded="false" aria-controls="radio-playlist"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 6h14M5 12h14M5 18h9" /></svg><span data-track-count>{firstChannel.tracks.length} 首</span></button>
    </footer>
    <div class="radio-list-region" data-list-region hidden>
    <ol id="radio-playlist" class="radio-playlist" data-playlist aria-label={`${firstChannel.title}曲目`}>
      {radioChannels.flatMap(channel => channel.tracks.map(track => <li data-track-channel={channel.id} hidden={channel.id !== firstChannel.id}><button data-track={track.id} type="button" aria-current={track.id === first.id ? "true" : undefined} aria-label={`播放 ${track.title}`}><img src={radioCover(track)} data-track-cover={track.id} width="36" height="36" alt="" loading="lazy" /><span><span class="radio-list-title">{track.title}</span><span class="radio-list-mood">{track.mood}</span></span><span class="radio-list-duration">{time(track.duration)}</span></button></li>))}
    </ol>
    </div>
  </div>
</section>

<script>
  import "../scripts/radio";
</script>

<style is:global>
  .field-radio { position: fixed; z-index: 40; left: max(24px, env(safe-area-inset-left)); bottom: max(24px, env(safe-area-inset-bottom)); color: var(--color-text); font-family: var(--font-sans); --radio-progress: 0%; background: #eeece3; border: 1px solid #b6c0ad; border-radius: 34px; overflow: clip; contain: layout style; box-shadow: 0 8px 32px #142d2424, 0 2px 6px #142d240a; isolation: isolate; }
  .field-radio [hidden], .field-radio[hidden] { display: none !important; }
  .field-radio button { cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .field-radio svg { display: block; width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.65; stroke-linecap: round; stroke-linejoin: round; }
  .radio-launcher { position: absolute; left: 0; bottom: 0; width: max-content; display: flex; align-items: center; background: transparent; border: 0; border-radius: 40px; padding: 5px 9px 5px 5px; }
  .radio-open { display: flex; align-items: center; gap: 11px; background: none; border: 0; color: inherit; text-align: left; padding: 0 4px 0 0; border-radius: 30px; }
  .radio-record { display: grid; place-items: center; width: 50px; height: 50px; border-radius: 50%; background: repeating-radial-gradient(circle, #1f3028 0 2px, #35443a 3px, #203027 4px); border: 3px solid #1f3028; box-shadow: 0 1px 3px #14271f40; animation: radio-spin 16s linear infinite; animation-play-state: paused; }
  .radio-record img { width: 26px; height: 26px; object-fit: cover; border-radius: 50%; border: 1px solid #a8b78b; }
  .radio-launcher-copy { display: grid; gap: 1px; min-width: 65px; }
  .radio-launcher-copy > span:first-child { font: 600 14px/1.65 var(--font-serif); letter-spacing: 1px; }
  .radio-launcher-copy > span:last-child { font-size: 10px; line-height: 1.7; color: var(--color-muted); }
  .radio-icon-button { border: 0; background: transparent; color: #506346; width: 44px; height: 44px; padding: 11px; display: grid; place-items: center; border-radius: 50%; flex: 0 0 auto; }
  .radio-icon-button:hover, .radio-list-toggle:hover { background: #dce0cf; }
  .radio-mini-play { width: 38px; height: 44px; padding: 9px; }
  .radio-panel { position: absolute; left: 0; bottom: 0; width: 360px; max-height: calc(100dvh - 48px); overflow-y: auto; overscroll-behavior: contain; padding: 14px 24px 12px; border: 0; border-radius: 20px; background: transparent; }
  .radio-heading-row { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; justify-content: space-between; margin: 0 -8px 3px 0; background: var(--color-paper); box-shadow: 0 -16px var(--color-paper); }
  .radio-channel-toggle { display: flex; align-items: center; gap: 10px; width: 100%; min-height: 44px; margin: 0 0 17px; padding: 0 10px; border: 1px solid var(--color-line); border-radius: 8px; background: transparent; color: var(--color-text); text-align: left; font-size: 12px; }
  .radio-channel-caption { font-size: 10px; color: var(--color-muted); }
  .radio-channel-toggle svg { width: 17px; height: 17px; margin-left: auto; transition: transform .4s var(--ease-out); }
  .radio-channel-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  .radio-channel-toggle:hover { background: #e0e4d580; border-color: var(--color-line-strong); }
  .radio-channel-region { overflow: hidden; }
  .radio-channels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; padding-bottom: 18px; }
  .radio-channels button { display: grid; gap: 3px; min-height: 54px; padding: 9px 11px; border: 1px solid transparent; border-radius: 7px; background: transparent; color: var(--color-text); text-align: left; font-size: 12px; }
  .radio-channels small { font-size: 10px; color: var(--color-muted); }
  .radio-channels button:hover { background: #e0e4d580; }
  .radio-channels [aria-pressed="true"] { background: #e0e4d5; border-color: #b6c0ad; }
  .radio-heading-row h2 { display: flex; align-items: center; gap: 9px; font: 600 16px/1.5 var(--font-serif); letter-spacing: 1.5px; }
  .radio-signal { display: flex; align-items: center; gap: 3px; height: 15px; color: #627643; }
  .radio-signal i { display: block; width: 2px; height: 6px; border-radius: 2px; background: currentColor; }
  .radio-signal i:nth-child(2) { height: 14px; }
  .radio-signal i:nth-child(3) { height: 9px; }
  .radio-now { display: flex; align-items: center; gap: 17px; }
  .radio-cover { width: 80px; height: 80px; flex-shrink: 0; object-fit: cover; border-radius: 8px; box-shadow: 0 3px 10px #25352620; }
  .radio-track-copy { min-width: 0; }
  .radio-mood { font-size: 10px; color: #606c5d; line-height: 1.65; margin-bottom: 5px; }
  .radio-track-copy h3 { font: 600 20px/1.4 var(--font-serif); overflow-wrap: anywhere; }
  .radio-artist { margin-top: 5px; font-size: 11px; color: var(--color-muted); line-height: 1.5; }
  .radio-message { margin-top: 19px; min-height: 20px; font: 12px/1.7 var(--font-serif); color: #606c5d; }
  .field-radio[data-error] .radio-message { color: #944128; }
  .radio-progress { margin-top: 8px; }
  .field-radio input[type="range"] { appearance: none; -webkit-appearance: none; display: block; width: 100%; height: 24px; margin: 0; cursor: pointer; background: transparent; border: 0; padding: 0; }
  .field-radio input[type="range"]::-webkit-slider-runnable-track { height: 3px; border-radius: 3px; background: linear-gradient(to right, #52693e var(--radio-progress), #cbd1c0 var(--radio-progress)); }
  .field-radio input[type="range"]::-moz-range-track { height: 3px; border-radius: 3px; background: #cbd1c0; }
  .field-radio input[type="range"]::-moz-range-progress { height: 3px; background: #52693e; }
  .field-radio input[type="range"]::-webkit-slider-thumb { appearance: none; -webkit-appearance: none; width: 10px; height: 10px; margin-top: -3.5px; border-radius: 50%; background: #52693e; }
  .field-radio input[type="range"]::-moz-range-thumb { width: 10px; height: 10px; border: 0; border-radius: 50%; background: #52693e; }
  .field-radio input:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: 4px; }
  .field-radio input:disabled { opacity: .5; cursor: default; }
  .radio-times { display: flex; justify-content: space-between; font-size: 10px; font-variant-numeric: tabular-nums; color: #606c5d; line-height: 1.5; }
  .radio-transport { display: flex; align-items: center; justify-content: center; gap: 24px; padding: 9px 0 16px; }
  .radio-main-play { display: grid; place-items: center; width: 54px; height: 54px; background: #455d35; color: #f5f3e9; border: 1px solid #455d35; border-radius: 50%; transition: background .15s; }
  .radio-main-play:hover { background: #344d26; }
  .radio-main-play svg { width: 24px; height: 24px; }
  .field-radio .radio-pause-icon { display: none; }
  .field-radio[data-active] .radio-play-icon { display: none; }
  .field-radio[data-active] .radio-pause-icon { display: block; }
  .field-radio[data-playing] .radio-record { animation-play-state: running; }
  .radio-tools { display: flex; justify-content: space-between; align-items: center; gap: 8px; border-top: 1px solid #ccd0c3; padding-top: 7px; }
  .radio-volume { display: flex; align-items: center; margin-left: -11px; width: 119px; }
  .radio-volume input { --radio-progress: 45%; }
  .radio-volume .radio-icon-button svg { width: 18px; height: 18px; }
  .field-radio .radio-mute-line, .field-radio[data-muted] .radio-volume-waves { display: none; }
  .field-radio[data-muted] .radio-mute-line { display: block; }
  .radio-ai { font-size: 10px; color: #606c5d; white-space: nowrap; }
  .radio-list-toggle { display: flex; align-items: center; justify-content: flex-end; gap: 6px; padding: 0 5px; height: 44px; border: 0; border-radius: 6px; background: none; font-size: 11px; color: #506346; white-space: nowrap; }
  .radio-list-toggle svg { width: 18px; height: 18px; }
  .radio-list-region { overflow: hidden; }
  .radio-playlist { list-style: none; border-top: 1px solid #ccd0c3; margin: 6px 0 0; padding: 7px 0 0; max-height: 190px; overflow-y: auto; overscroll-behavior: contain; }
  .radio-playlist button { display: flex; align-items: center; gap: 10px; width: 100%; padding: 9px 6px; border: 0; border-radius: 7px; text-align: left; background: transparent; color: inherit; }
  .radio-playlist button:hover, .radio-playlist [aria-current="true"] { background: #e0e4d5; }
  .radio-playlist button > img { width: 36px; height: 36px; object-fit: cover; border-radius: 4px; }
  .radio-playlist button > span:nth-child(2) { min-width: 0; flex: 1; }
  .radio-list-title { display: block; font-size: 12px; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .radio-list-mood { display: block; font-size: 10px; line-height: 1.6; color: #606c5d; }
  .radio-list-duration { font-size: 10px; color: #606c5d; font-variant-numeric: tabular-nums; }
  @keyframes radio-spin { to { transform: rotate(360deg); } }
  @media (max-width: 600px) {
    .field-radio { left: max(12px, env(safe-area-inset-left)); bottom: max(12px, env(safe-area-inset-bottom)); pointer-events: none; }
    .radio-launcher, .radio-panel { pointer-events: auto; }

    .radio-panel { width: min(calc(100vw - 26px - env(safe-area-inset-left) - env(safe-area-inset-right)), 380px); max-height: calc(100dvh - 24px - env(safe-area-inset-bottom)); padding-inline: 22px; }
    .radio-list-region { overflow: hidden; }
  .radio-playlist { max-height: 155px; }
  }
  .radio-icon-button, .radio-main-play { transition: background .25s, transform .25s var(--ease-out); }
  .radio-main-play:hover { transform: scale(1.06); }
  .radio-icon-button:active, .radio-main-play:active { transform: scale(.90); }
  .radio-playlist button { transition: background .25s, color .25s; }
  .radio-list-toggle svg { transition: transform .4s var(--ease-out); }
  .radio-list-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  .radio-signal i { transform-origin: center; }
  .field-radio[data-playing] .radio-signal i { animation: radio-signal .9s ease-in-out infinite alternate; }
  .field-radio[data-playing] .radio-signal i:nth-child(2) { animation-delay: -.3s; }
  .field-radio[data-playing] .radio-signal i:nth-child(3) { animation-delay: -.6s; }
  @keyframes radio-signal { from { transform: scaleY(.45); } to { transform: scaleY(1); } }
  @media (max-height: 680px) {
    .radio-panel { padding-top: 8px; }
    .radio-channel-toggle { margin-bottom: 12px; }
    .radio-channels { gap: 4px; padding-bottom: 12px; }
    .radio-channels button { min-height: 48px; padding: 6px 9px; line-height: 1.5; }
    .radio-channels small { line-height: 1.4; }
    .radio-cover { width: 64px; height: 64px; }
    .radio-now { gap: 13px; }
    .radio-track-copy h3 { font-size: 18px; }
    .radio-message { margin-top: 12px; }
    .radio-transport { padding-block: 6px 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .radio-record, .radio-panel, .field-radio[data-playing] .radio-signal i { animation: none; }
    .field-radio button, .field-radio svg { transition: none; }
    .radio-main-play:hover, .radio-icon-button:active, .radio-main-play:active { transform: none; }
  }
</style>
