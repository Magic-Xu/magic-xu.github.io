---
interface Props {
	title: string;
	summary: string;
	date: string;
	href: string;
	tags?: string[];
	readingTime?: number;
	index: number;
}

const { title, summary, date, href, tags = [], readingTime, index } = Astro.props;
---

<article class="writing-row motion-row">
	<div class="writing-meta">
		<p class="writing-number">{String(index).padStart(2, "0")}</p>
		<p>date: {date}</p>
		{readingTime && <p>reading time: {readingTime} 分钟</p>}
	</div>
	<div class="writing-body">
		<h2><a href={href}>{title}</a></h2>
		{tags.length > 0 && <ul class="tag-list" aria-label="文章标签">{tags.map((tag) => <li>{tag}</li>)}</ul>}
		<p>{summary}</p>
	</div>
	<a class="text-link writing-link" href={href}>阅读全文 <span aria-hidden="true">→</span></a>
</article>
