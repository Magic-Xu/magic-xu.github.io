---
import type { CollectionEntry } from "astro:content";
interface Props { places: CollectionEntry<"footprints">[]; }
const { places } = Astro.props;
const markers = places.filter(entry => entry.data.longitude !== undefined && entry.data.latitude !== undefined);
const views = [
	{ id: "china", name: "华夏", countries: ["中国"] },
	{ id: "japan", name: "日本", countries: ["日本"] },
	{ id: "southeast", name: "东南亚", countries: ["泰国", "越南", "马来西亚"] },
	{ id: "australia", name: "澳大利亚", countries: ["澳大利亚"] },
].filter(view => markers.some(entry => view.countries.includes(entry.data.country)));
---

<figure class="footprint-atlas" id="travel-map" data-travel-atlas>
	<div class="atlas-heading"><span>把记忆放回地图</span><span aria-hidden="true">↑ N</span></div>
	<div class="atlas-views" aria-label="地图范围" hidden>
		{views.map((view, index) => <button type="button" data-atlas-view={view.id} aria-pressed={index === 0 ? "true" : "false"}>{view.name}</button>)}
	</div>
	<div class="atlas-surface" aria-label="足迹地图" tabindex="0">
		<svg class="atlas-land" viewBox="85 -55 80 110" preserveAspectRatio="none" aria-hidden="true"><use href="/maps/asia-pacific-land.svg#land" /></svg>
		<div class="atlas-points">
			{markers.map(entry => <a class:list={["atlas-pin", entry.data.locationType === "region" && "atlas-region"]}
				href={`#footprint-${entry.id}`} data-atlas-place={entry.id} data-name={entry.data.place}
				data-region={entry.data.region} data-country={entry.data.country}
				data-longitude={entry.data.longitude} data-latitude={entry.data.latitude}
				style={`left:${(entry.data.longitude! - 85) / 80 * 100}%;top:${(55 - entry.data.latitude!) / 110 * 100}%`}
				aria-label={`查看${entry.data.place}${entry.data.locality ? `（${entry.data.locality}）` : ""}的足迹`}>
				<span class="atlas-dot" aria-hidden="true"></span><span class="atlas-label">{entry.data.place}</span>
			</a>)}
		</div>
		<div class="atlas-controls" hidden>
			<button type="button" data-atlas-zoom="in" aria-label="放大地图">+</button>
			<button type="button" data-atlas-zoom="out" aria-label="缩小地图">−</button>
			<button type="button" class="atlas-reset" aria-label="地图全览">↺</button>
		</div>
	</div>
	<figcaption>
		<p class="atlas-credit"><a href="https://www.naturalearthdata.com/about/terms-of-use/" target="_blank" rel="noreferrer">Natural Earth</a><span>·</span><a href="https://www.geonames.org/" target="_blank" rel="noreferrer">GeoNames</a></p>
	</figcaption>
</figure>

<script>import "../scripts/footprint-atlas";</script>

<style>
	.footprint-atlas { margin: 0; scroll-margin-top: 140px; }
	.atlas-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; color: var(--color-muted); font: 13px/1.8 var(--font-serif); letter-spacing: 1px; }
	.atlas-heading > span:last-child { font: 11px var(--font-sans); letter-spacing: 2px; }
	.atlas-views { display: flex; flex-wrap: wrap; gap: 0 23px; margin-bottom: 14px; }
	.atlas-views[hidden] { display: none; }
	.atlas-views button { padding: 0; min-height: 44px; border: 0; border-bottom: 1px solid transparent; background: transparent; color: var(--color-muted); font: 14px var(--font-serif); cursor: pointer; }
	.atlas-views button[aria-pressed="true"] { color: var(--color-accent); border-bottom-color: currentColor; }
	.atlas-surface { position: relative; isolation: isolate; overflow: hidden; aspect-ratio: 1.2; background: #e8e9df; border: 1px solid var(--color-line); }
	.atlas-surface[data-interactive] { cursor: grab; touch-action: none; user-select: none; }
	.atlas-surface[data-dragging] { cursor: grabbing; }
	.atlas-surface::after { position: absolute; z-index: -1; inset: 0; content: ""; background-image: linear-gradient(#83977712 1px, transparent 1px), linear-gradient(90deg, #83977712 1px, transparent 1px); background-size: 25% 25%; pointer-events: none; }
	.atlas-land { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; }
	.atlas-points { position: absolute; inset: 0; }
	.atlas-pin, .atlas-points :global(.atlas-cluster) { position: absolute; transform: translate(-50%, -50%); width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; color: var(--color-text); }
	.atlas-pin[hidden] { display: none; }
	.atlas-dot { width: 7px; height: 7px; background: var(--color-paper); border: 1px solid var(--color-accent); border-radius: 50%; transition: box-shadow .25s, background .25s; }
	.atlas-region .atlas-dot { width: 12px; height: 12px; border-style: dashed; }
	.atlas-label, .atlas-points :global(.atlas-cluster-label) { position: absolute; top: 39px; left: 50%; transform: translateX(-50%); white-space: nowrap; font: 12px/1.6 var(--font-serif); text-shadow: 0 0 4px #e8e9df, 0 0 4px #e8e9df; }
	.atlas-pin:hover, .atlas-pin:focus-visible, .atlas-pin[aria-current] { z-index: 2; }
	.atlas-pin:hover .atlas-dot, .atlas-pin[aria-current] .atlas-dot { background: var(--color-accent); box-shadow: 0 0 0 6px #455d3514; }
	.atlas-pin[aria-current] .atlas-label { color: var(--color-accent); text-decoration: underline; text-underline-offset: 4px; }
	.atlas-points :global(.atlas-cluster) { padding: 0; border: 1px solid #adb8a7; background: #eeece3ed; font: 14px var(--font-serif); cursor: pointer; }
	.atlas-points :global(.atlas-cluster:hover) { background: var(--color-paper); border-color: var(--color-accent); }
	.atlas-controls { display: flex; position: absolute; right: 12px; bottom: 12px; border: 1px solid var(--color-line-strong); background: var(--color-paper); }
	.atlas-controls[hidden] { display: none; }
	.atlas-controls button { width: 44px; height: 44px; padding: 0; color: var(--color-accent); background: transparent; border: 0; font: 21px var(--font-sans); cursor: pointer; }
	.atlas-controls button + button { border-left: 1px solid var(--color-line); }
	.atlas-controls button:hover { background: var(--color-surface-raised); }
	.atlas-controls button:disabled { opacity: .35; cursor: default; }
	button:focus-visible, .atlas-surface:focus-visible, .atlas-pin:focus-visible, .atlas-points :global(.atlas-cluster:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 2px; }
	.atlas-credit { display: flex; justify-content: flex-end; gap: 5px; margin: 12px 0 0; color: var(--color-muted); font: 10px/1.8 var(--font-sans); }
	.atlas-credit a { text-decoration: underline; text-underline-offset: 3px; }
	@media (min-width: 761px) { .atlas-surface { max-height: max(200px, calc(100dvh - 250px)); } }
	@media (max-width: 760px) { .atlas-views { gap: 0 20px; } .atlas-label { font-size: 11px; } }
	@media (prefers-reduced-motion: reduce) { .atlas-dot { transition: none; } }
</style>
