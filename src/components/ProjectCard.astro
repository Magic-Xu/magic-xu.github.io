---
import Arrow from "./Arrow.astro";
import type { ProjectItem } from "../content/types";
interface Props extends ProjectItem { index: number }
const { name, description, status, stack, tagline, linkLabel, linkHref, links, index } = Astro.props;
const projectLinks = links ?? (linkHref && linkLabel ? [{ label: linkLabel, href: linkHref }] : []);
const projectId = name.toLowerCase().replaceAll(" ", "-");
---
<details id={projectId} class="project-entry">
  <summary class="project-summary">
    <span class="project-number">{String(index).padStart(2, "0")}</span>
    <h2>{name}</h2>
    <span class="project-short-description">{tagline ?? description}</span>
    <span class="project-entry-status">{status}</span>
    <span class="project-expand" aria-hidden="true"><Arrow /></span>
  </summary>
  <div class="project-expanded">
    <p>{description}</p>
    <ul class="stack-list" aria-label="技术栈">{stack.map((item) => <li>{item}</li>)}</ul>
    {projectLinks.length > 0 && <div class="project-links">{projectLinks.map((link) => <a class="text-link" href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noreferrer" : undefined}>{link.label} <Arrow direction="up-right" /></a>)}</div>}
  </div>
</details>
