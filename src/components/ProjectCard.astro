---
interface Props {
	name: string;
	description: string;
	status: string;
	stack: string[];
	tagline?: string;
	linkLabel?: string;
	linkHref?: string;
	links?: { label: string; href: string }[];
	index: number;
	featured?: boolean;
}

const { name, description, status, stack, tagline, linkLabel, linkHref, links, index, featured = false } = Astro.props;
const projectLinks = links ?? (linkHref && linkLabel ? [{ label: linkLabel, href: linkHref }] : []);
const projectId = name.toLowerCase().replaceAll(" ", "-");
---

<article id={projectId} class:list={["project-row", featured && "project-row-featured", "motion-row"]}>
	<p class="project-number">{String(index).padStart(2, "0")}</p>
	<div class="project-body">
		<header class="project-card-head">
			<h2>{name}</h2>
			<span class="project-status">{status}</span>
		</header>
		{tagline && <p class="project-tagline">{tagline}</p>}
		<p class="project-description">{description}</p>
		{projectLinks.length > 0 && (
			<div class="project-links">
				{projectLinks.map((item) => {
					const isExternal = item.href.startsWith("http");
					return <a class="text-link" href={item.href} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noreferrer" : undefined}>{item.label} <span aria-hidden="true">→</span></a>;
				})}
			</div>
		)}
	</div>
	<ul class="stack-list" aria-label="技术栈">
		{stack.map((item) => <li>{item}</li>)}
	</ul>
</article>
