---
import type { CollectionEntry } from "astro:content";
import { projectPlace } from "../lib/journal";
interface Props { places: CollectionEntry<"footprints">[]; }
const { places } = Astro.props;
const markers = places.map(entry => ({ entry, ...projectPlace(entry.data.longitude, entry.data.latitude) }))
	.filter(({ x, y }) => x >= 0 && x <= 100 && y >= 0 && y <= 100);
---

<figure class="footprint-map">
	<div class="map-heading"><span>把记忆放回地图</span><span class="map-north" aria-hidden="true">↑ N</span></div>
	<div class="map-surface" aria-label="足迹地点图">
		<img src="/maps/east-asia-land.svg" width="720" height="560" alt="" class="map-land" />
		{markers.map(({ entry, x, y }) => <a
			class:list={["map-place", x > 70 && "map-place-left"]}
			href={`#footprint-${entry.id}`}
			data-place={entry.id}
			style={`--map-x:${x}%;--map-y:${y}%`}
			aria-label={`查看${entry.data.place}的足迹`}
			aria-current={entry === places[0] ? "location" : undefined}
		>
			<span class="map-dot" aria-hidden="true"></span><span class="map-label">{entry.data.place}</span>
		</a>)}
	</div>
	<figcaption><span>点一个地名，翻开那段记忆。</span><a href="https://www.naturalearthdata.com/about/terms-of-use/" target="_blank" rel="noreferrer">底图 Natural Earth <span class="visually-hidden">（新窗口）</span></a></figcaption>
</figure>

<style>
	.footprint-map { margin: 0; }
	.map-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; font: 13px/1.8 var(--font-serif); letter-spacing: 1px; color: var(--color-muted); }
	.map-north { font: 11px var(--font-sans); letter-spacing: 2px; }
	.map-surface { position: relative; isolation: isolate; aspect-ratio: 720 / 560; background-color: #e8e9df; border: 1px solid var(--color-line); }
	.map-surface::after { position: absolute; z-index: -1; inset: 0; content: ""; background-image: linear-gradient(#83977712 1px, transparent 1px), linear-gradient(90deg, #83977712 1px, transparent 1px); background-size: 25% 25%; pointer-events: none; }
	.map-land { position: absolute; z-index: -2; inset: 0; display: block; width: 100%; height: 100%; }
	.map-place { position: absolute; left: var(--map-x); top: var(--map-y); width: 44px; height: 44px; transform: translate(-50%, -50%); display: grid; place-items: center; color: var(--color-text); border-radius: 50%; }
	.map-dot { width: 7px; height: 7px; border: 1px solid var(--color-accent); border-radius: 50%; background: var(--color-paper); transition: box-shadow .35s var(--ease-out), background .25s, transform .35s var(--ease-out); }
	.map-label { position: absolute; left: 30px; white-space: nowrap; padding: 2px 3px; font: 13px/1.6 var(--font-serif); text-shadow: 0 1px 3px #e8e9df; transition: color .25s; }
	.map-place-left .map-label { left: auto; right: 30px; }
	.map-place:hover .map-dot, .map-place[aria-current] .map-dot { background: var(--color-accent); box-shadow: 0 0 0 6px #455d3514; transform: scale(1.15); }
	.map-place[aria-current] .map-label { color: var(--color-accent); text-decoration: underline; text-underline-offset: 5px; }
	.map-place:focus-visible { outline: 1px solid var(--color-accent); outline-offset: 1px; }
	figcaption { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8px 15px; margin-top: 16px; color: var(--color-muted); font: 11px/1.8 var(--font-sans); }
	figcaption a { font-size: 10px; text-decoration: underline; text-underline-offset: 3px; }
	@media (max-width: 760px) { .map-heading { margin-bottom: 17px; } .map-label { font-size: 12px; } }
	@media (prefers-reduced-motion: reduce) { .map-dot, .map-label { transition: none; } }
</style>
