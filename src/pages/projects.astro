---
import { getLocaleContent } from "../content";
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const content = getLocaleContent();
const { projects } = content;
---

<BaseLayout metaTitle={projects.metaTitle} metaDescription={projects.metaDescription}>
	<section class="section projects-section">
		<div class="container">
			<header class="page-heading" data-reveal-group>
				<h1 class="page-title">{projects.title}</h1>
				<p class="page-desc">{projects.description}</p>
			</header>
			<div class="project-index">
				{projects.items.map((project, index) => <ProjectCard {...project} index={index + 1} featured={index === 0} />)}
			</div>
		</div>
	</section>
</BaseLayout>
