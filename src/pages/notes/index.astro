---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import JournalPreview from "../../components/JournalPreview.astro";
import JournalEmpty from "../../components/JournalEmpty.astro";
import Arrow from "../../components/Arrow.astro";
import { getNotes, getFootprints, journalYear, journalDate, journalMonthDay } from "../../lib/journal";

const entries = await getNotes();
const notes = await Promise.all(entries.map(async entry => ({ entry, ...await render(entry) })));
const places = new Map((await getFootprints()).map(entry => [entry.id, entry.data.place]));
for (const { entry } of notes) {
	if (entry.data.footprint && !places.has(entry.data.footprint)) throw new Error(`Unknown published footprint: ${entry.data.footprint} in note ${entry.id}`);
}
const years = [...new Set(entries.map(entry => journalYear(entry.data.date)))];
const hasDemo = entries.some(entry => entry.data.demo);
---

<BaseLayout metaTitle="随笔" metaDescription="几句感悟，一点日常。小麦在野的短篇手记。" noIndex={hasDemo || !notes.length}>
	<section class="section notes-page">
		<div class="container">
			<header class="collection-heading" data-reveal-group>
				<h1 class="page-title">随手记下。</h1>
				<p>几句感悟，一点日常。</p>
			</header>
			{hasDemo && <JournalPreview kind="随笔" />}
			{notes.length ? <div class="notes-layout">
				<aside class="notes-margin">
					<div class="notes-index">
						<p class="notes-count">共 {notes.length} 则随笔</p>
						<nav aria-label="随笔年份">{years.map(year => <a href={`#notes-${year}`}>{year}<Arrow /></a>)}</nav>
						<p class="margin-thought">写在生活的<br />页边。</p>
					</div>
				</aside>
				<div class="notes-stream">
					{years.map(year => <section class="notes-year" id={`notes-${year}`} aria-labelledby={`year-title-${year}`}>
						<h2 id={`year-title-${year}`}>{year}<span>年</span></h2>
						{notes.filter(({ entry }) => journalYear(entry.data.date) === year).map(({ entry, Content }) => <article class="note" id={`note-${entry.id}`} aria-label={`${journalDate(entry.data.date)} · ${entry.data.topic}随笔`}>
							<div class="note-meta">
								<a href={`#note-${entry.id}`} aria-label={`定位 ${journalDate(entry.data.date)} 的随笔`}><time datetime={journalDate(entry.data.date)}>{journalMonthDay(entry.data.date)}</time></a>
								<span>{entry.data.topic}</span>
							</div>
							<div class="note-body">
								<div class="note-copy"><Content /></div>
								{entry.data.footprint && <a class="note-place" href={`/footprints/#footprint-${entry.data.footprint}`}>
									<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15.5 8c0 4-5.5 9-5.5 9S4.5 12 4.5 8a5.5 5.5 0 1 1 11 0Z"/><circle cx="10" cy="8" r="1.8"/></svg>
									{places.get(entry.data.footprint)}<Arrow />
								</a>}
							</div>
						</article>)}
					</section>)}
					<div class="notes-colophon"><p>长一些的思考，收在文章里。</p><a class="text-link" href="/writing/">去读文章 <Arrow /></a></div>
				</div>
			</div> : <JournalEmpty kind="notes" />}
		</div>
	</section>
</BaseLayout>

<style>
	.notes-layout { display: grid; grid-template-columns: 160px minmax(0, 760px); gap: clamp(40px, 7vw, 100px); }
	.notes-index { position: sticky; top: 128px; padding-top: 13px; }
	.notes-count { margin: 0 0 23px; font: 12px/1.8 var(--font-sans); color: var(--color-muted); }
	.notes-index nav { display: grid; gap: 4px; }
	.notes-index nav a { display: flex; align-items: center; gap: 35px; min-height: 44px; width: fit-content; font: 18px/1.5 var(--font-serif); font-variant-numeric: tabular-nums; }
	.notes-index nav :global(.arrow-icon) { width: 16px; height: 16px; opacity: .6; }
	.margin-thought { margin-top: 80px; color: var(--color-muted); font: 18px/2.1 var(--font-serif); letter-spacing: 2px; }
	.notes-year { scroll-margin-top: 120px; }
	.notes-year + .notes-year { margin-top: 62px; }
	.notes-year h2 { display: flex; align-items: baseline; gap: 10px; margin: 0; padding-bottom: 26px; border-bottom: 1px solid var(--color-line-strong); font: 400 32px/1.5 var(--font-serif); }
	.notes-year h2 span { font: 12px var(--font-sans); color: var(--color-muted); }
	.note { display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 32px; padding: 36px 0 40px; border-bottom: 1px solid var(--color-line); scroll-margin-top: 122px; }
	.note-meta { display: flex; flex-direction: column; align-items: flex-start; padding-top: 5px; color: var(--color-muted); font: 12px/1.8 var(--font-sans); }
	.note-meta a { display: inline-flex; min-height: 30px; font-size: 13px; font-variant-numeric: tabular-nums; }
	.note-meta span { margin-top: 4px; }
	.note-copy { font: 400 20px/2.05 var(--font-serif); overflow-wrap: anywhere; }
	.note-copy :global(p) { margin: 0; }
	.note-copy :global(p + p) { margin-top: 13px; }
	.note-copy :global(a) { text-decoration: underline; text-underline-offset: 5px; }
	.note-copy :global(img) { max-width: 100%; height: auto; margin-block: 16px; }
	.note-place { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; margin-top: 15px; color: var(--color-accent); font: 12px/1.7 var(--font-sans); }
	.note-place svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.2; }
	.note-place :global(.arrow-icon) { width: 16px; height: 16px; margin-left: 7px; }
	.notes-colophon { margin-top: 52px; display: flex; align-items: center; justify-content: space-between; gap: 20px; font-size: 13px; color: var(--color-muted); }
	.notes-colophon p { margin: 0; }
	.notes-colophon a { flex: none; font-size: 13px; }
	@media (max-width: 1000px) {
		.notes-layout { grid-template-columns: 100px minmax(0, 1fr); gap: 38px; }
		.note { grid-template-columns: 72px minmax(0, 1fr); gap: 24px; }
	}
	@media (max-width: 760px) {
		.notes-layout { display: block; }
		.notes-index { position: static; display: flex; align-items: center; justify-content: space-between; padding: 0; margin-bottom: 26px; }
		.notes-count { margin: 0; }
		.notes-index nav { display: flex; gap: 20px; }
		.notes-index nav a { font-size: 16px; }
		.notes-index nav :global(.arrow-icon), .margin-thought { display: none; }
		.notes-year { scroll-margin-top: 130px; }
		.notes-year h2 { font-size: 28px; padding-bottom: 20px; }
		.note { display: block; padding: 26px 0 30px; scroll-margin-top: 130px; }
		.note-meta { flex-direction: row; align-items: baseline; gap: 18px; padding: 0; margin-bottom: 14px; }
		.note-meta span { margin: 0; }
		.note-meta a { min-height: 24px; }
		.note-copy { font-size: 18px; line-height: 2.05; }
		.notes-year + .notes-year { margin-top: 44px; }
		.notes-colophon { align-items: flex-start; flex-direction: column; gap: 8px; margin-top: 36px; }
	}
</style>
