---
import BaseLayout from "../layouts/BaseLayout.astro";
import Arrow from "../components/Arrow.astro";
import { getPublishedPosts } from "../lib/blog";
import { siteConfig } from "../data/site";
const posts = (await getPublishedPosts()).slice(0, 2);
const shortTitle = (title: string) => title.replace(/^独立 App 开发系列：\s*/, "");
---
<BaseLayout metaDescription={siteConfig.description} home>
  <section class="home-hero" aria-labelledby="home-title">
    <picture class="hero-landscape" aria-hidden="true">
      <img src="/images/home/mountain-dawn-wide.webp" width="1600" height="750" alt="" fetchpriority="high" decoding="async" />
    </picture>
    <div class="container hero-inner">
      <div class="hero-copy">
        <h1 id="home-title">小麦在野</h1>
        <p class="hero-identity"><span lang="en">MagicXu</span><span class="identity-divider" aria-hidden="true">/</span>独立开发者 · AI 探索者</p>
        <hr class="hero-rule" />
        <p class="hero-statement"><span>做自己的产品，</span><span>记录真实的探索。</span></p>
        <p class="hero-intro">十年研发，保持好奇。探索 AI、独立开发，<br class="desktop-break" />以及更自由的工作与生活。</p>
        <a class="hero-link" href="/about/">从这里认识我 <Arrow direction="up-right" /></a>
        <p class="hero-caption" lang="en">A MORE OPEN,<br />INTERESTING TOMORROW.</p>
      </div>
      <p class="hero-note">更大的世界<br /><span>仍在前方。</span></p>
    </div>
  </section>
  <section class="home-journal container" aria-labelledby="recent-title">
    <p class="margin-label" lang="en">FIELD<br />NOTES</p>
    <div class="recent-writing">
      <div class="section-heading"><h2 id="recent-title">最近写下</h2><a class="all-writing" href="/writing/">全部文章 <Arrow /></a></div>
      <ul class="recent-list">{posts.map((post) => (<li><a href={`/writing/${post.id}/`}><span>{shortTitle(post.data.title)}</span><Arrow /></a></li>))}</ul>
    </div>
    <aside class="current-work" aria-labelledby="current-work-title">
      <h2 id="current-work-title">正在做</h2>
      <a class="work-entry" href="/projects/#snapmosaic"><h3>SnapMosaic</h3><p>在设备上，保护照片隐私。</p><Arrow /></a>
    </aside>
  </section>
</BaseLayout>
