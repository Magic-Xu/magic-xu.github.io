---
import { getLocaleContent } from "../content";
import BaseLayout from "../layouts/BaseLayout.astro";

const content = getLocaleContent();
const { home } = content;
const featuredProject = content.projects.items.find((project) => project.name === "SnapMosaic");
---

<BaseLayout metaTitle={home.metaTitle} metaDescription={home.metaDescription}>
	<section class="home-hero">
		<div class="container home-grid">
			<div class="home-copy" data-reveal-group>
				<h1>
					<span>Small apps.</span>
					<span>Real problems.</span>
					<em>Built with care.</em>
				</h1>
				<p class="home-role">Android engineer · AI explorer · Independent developer</p>
				<p class="home-intro">I build mobile products that solve real problems with elegant design and thoughtful engineering.<br />From idea to shipped, by one developer.</p>
				<div class="home-actions" aria-label="首页快捷入口">
					<a class="button primary" href="#snapmosaic">Explore SnapMosaic <span aria-hidden="true">→</span></a>
					<a class="button secondary" href="/projects">All projects</a>
				</div>
				<div class="privacy-proof">
					<span class="privacy-mark" aria-hidden="true">S</span>
					<div>
						<strong>Private photo masking, on device.</strong>
						<small>Local-first <i></i> No account <i></i> System share</small>
					</div>
				</div>
			</div>

			{featuredProject && (
				<div class="product-stack" id="snapmosaic" aria-label="SnapMosaic featured product">
					<div class="code-panel code-panel-top" aria-hidden="true">
						<div class="window-dots"><span></span><span></span><span></span></div>
						<code>state.reduce(intent)</code>
						<code>privacy.mask(onDevice)</code>
						<code>render(shareReady)</code>
					</div>
					<article class="featured-product motion-card">
						<div class="product-topbar">
							<div class="window-dots"><span></span><span></span><span></span></div>
							<span>SHIPPED / ON DEVICE</span>
						</div>
						<p class="product-label">Featured Product</p>
						<h2>{featuredProject.name}</h2>
						<p class="product-tagline">{featuredProject.tagline}</p>
						<p class="product-copy">Mask faces, names, license plates, receipts, and screenshots before sharing — without sending private photos to the cloud.</p>
						<div class="privacy-grid" aria-label="SnapMosaic features">
							<span>Local-first</span><span>Mosaic</span><span>Blur</span><span>Block</span><span>No account</span><span>System share</span>
						</div>
						<div class="project-links">
							{featuredProject.links?.map((item) => (
								<a class="text-link" href={item.href} target="_blank" rel="noreferrer">{item.label}</a>
							))}
						</div>
					</article>
					<div class="code-panel code-panel-bottom" aria-hidden="true">
						<div class="window-dots"><span></span><span></span><span></span></div>
						<code>AI.observe(input)</code>
						<code>ship.small()</code>
					</div>
				</div>
			)}
		</div>
	</section>

	<nav class="home-strip" aria-label="精选入口">
		<a href="/projects#melonest"><span class="strip-icon" aria-hidden="true">♪</span><span><strong>MeloNest</strong><small>AI music, kept in your local library.</small></span></a>
		<a href="/projects#app-dev-skills"><span class="strip-icon" aria-hidden="true">⌘</span><span><strong>App Dev Skills</strong><small>Local-first Android workflows.</small></span></a>
		<a href="/writing"><span class="strip-icon" aria-hidden="true">↗</span><span><strong>Writing</strong><small>Notes on Android, AI, and building.</small></span></a>
	</nav>
</BaseLayout>
