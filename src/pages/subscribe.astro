---
import BaseLayout from "../layouts/BaseLayout.astro";
import Arrow from "../components/Arrow.astro";
import { siteConfig } from "../data/site";

const feedUrl = new URL("/rss.xml", siteConfig.url).href;
---

<BaseLayout metaTitle="RSS 订阅" metaDescription="通过 RSS 订阅小麦在野，在你使用的阅读器中接收新文章。">
  <section class="section">
    <div class="container subscribe-page">
      <header class="page-heading">
        <h1 class="page-title">通过 RSS 订阅文章</h1>
        <p class="page-desc">复制订阅地址，在你使用的 RSS 阅读器中添加订阅，即可接收新文章。</p>
      </header>
      <div class="feed-subscription" data-feed-subscription>
        <label for="feed-address">订阅地址</label>
        <div class="feed-controls">
          <input id="feed-address" type="text" value={feedUrl} readonly spellcheck="false" />
          <button type="button" data-copy-feed hidden>复制订阅地址</button>
        </div>
        <p class="copy-status" role="status" aria-live="polite" data-copy-status></p>
        <a class="text-link" href="/rss.xml" data-astro-reload>查看 RSS 源文件 <Arrow /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initFeedCopy() {
    const subscription = document.querySelector<HTMLElement>("[data-feed-subscription]");
    if (!subscription || subscription.dataset.bound) return;
    const address = subscription.querySelector<HTMLInputElement>("#feed-address");
    const button = subscription.querySelector<HTMLButtonElement>("[data-copy-feed]");
    const status = subscription.querySelector<HTMLElement>("[data-copy-status]");
    if (!address || !button || !status) return;

    subscription.dataset.bound = "true";
    button.hidden = false;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(address.value);
        status.textContent = "订阅地址已复制，可粘贴到你的 RSS 阅读器。";
      } catch {
        address.focus();
        address.select();
        status.textContent = "请手动复制已选中的订阅地址。";
      }
    });
  }

  initFeedCopy();
  document.addEventListener("astro:page-load", initFeedCopy);
</script>

<style>
  .subscribe-page { max-width: 820px; }
  .page-heading { margin-bottom: 40px; }
  .page-desc { max-width: 630px; }
  .feed-subscription { border-top: 1px solid var(--color-line); padding-top: 30px; }
  label { display: block; margin-bottom: 12px; color: var(--color-muted); font-size: 14px; }
  .feed-controls { display: flex; gap: 12px; }
  input { flex: 1; min-width: 0; width: 100%; padding: 13px 16px; border: 1px solid var(--color-line-strong); border-radius: 0; background: transparent; color: var(--color-text); }
  input:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  button { flex-shrink: 0; padding: 13px 22px; border: 1px solid var(--color-accent); border-radius: 0; background: var(--color-accent); color: var(--color-paper); cursor: pointer; }
  button:hover { background: var(--color-text); border-color: var(--color-text); }
  .copy-status { min-height: 1.8em; margin-top: 12px; color: var(--color-muted); font-size: 14px; }
  .text-link { margin-top: 16px; }
  @media (max-width: 640px) {
    .feed-controls { flex-direction: column; }
    input { font-size: 14px; padding-inline: 12px; }
    button { align-self: flex-start; }
    .page-title { font-size: 32px; }
  }
</style>
