---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { formatPubDate, getPublishedPosts } from "../../lib/blog";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
	const posts = await getPublishedPosts();

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post }
	}));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content, headings } = await render(post);
const tocItems = [
	{ depth: 1, slug: "article-top", text: post.data.title },
	...headings
		.filter((heading) => heading.depth > 1 && heading.depth <= 3)
		.map((heading) => ({
			depth: heading.depth,
			slug: heading.slug,
			text: heading.text
		}))
];
---

<BaseLayout>
	<section class="section article-section">
		<div class="container article-layout">
			<aside class="article-toc" aria-label="文章目录">
				<a class="toc-back" href="/writing/">返回 Writing</a>
				<p class="toc-label">目录</p>
				<nav>
					{tocItems.map((item) => (
						<a class={`toc-link toc-depth-${item.depth}`} href={`#${item.slug}`}>
							{item.text}
						</a>
					))}
				</nav>
			</aside>

			<article id="article-top" class="article-detail">
				<header class="article-header">
					<a class="text-link back-link" href="/writing/">返回 Writing</a>
					<h1 class="page-title">{post.data.title}</h1>
					<p class="meta-line">
						发布日期：{formatPubDate(post.data.pubDate)}
						{post.data.readingTime && <> · 预计阅读 {post.data.readingTime} 分钟</>}
					</p>
					{post.data.tags && post.data.tags.length > 0 && (
						<ul class="tag-list" aria-label="文章标签">
							{post.data.tags.map((tag) => <li>{tag}</li>)}
						</ul>
					)}
					<p class="page-desc article-summary">{post.data.description}</p>
				</header>

				<div class="article-prose">
					<Content />
				</div>
			</article>
		</div>
	</section>
</BaseLayout>
